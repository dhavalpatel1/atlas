# Doxyfile 1.9.6 — Atlas project, GitHub Pages optimized

# Project info
PROJECT_NAME           = "Atlas"
PROJECT_BRIEF          = "C project for high-performance modular applications"
OUTPUT_DIRECTORY       = .
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = YES

# Input
INPUT                  = libs apps README.md
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE                = build .cache .github
USE_MDFILE_AS_MAINPAGE = README.md

# Extraction options
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE_HUE    = 200
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_TIMESTAMP         = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
GENERATE_INDEX         = YES
HTML_DYNAMIC_SECTIONS  = YES
INTERACTIVE_SVG        = YES
HTML_HEADER            = 
HTML_FOOTER            = 
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

# Graphviz support
HAVE_DOT               = YES
DOT_NUM_THREADS        = 2
DOT_FONTNAME           = Helvetica
DOT_FONTSIZE           = 10
DOT_PATH               = /usr/bin/dot
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_DIAGRAMS         = YES
DOT_IMAGE_FORMAT       = svg

# Warnings and error checking
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

# Disable unnecessary outputs
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# Misc
ALIASES                =
GENERATE_TAGFILE       =
